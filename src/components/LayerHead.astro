---
/** Section header for one information layer: badge + title + what this layer is (and is not). */
import type { Layer } from '../core/schema';
import { layer as labels } from '../i18n/ko';
import LayerBadge from './LayerBadge.astro';
interface Props { layer: Layer; title?: string; count?: number; id?: string }
const { layer, title, count, id } = Astro.props;
---
<div class="section-head layer-head" data-layer={layer} id={id}>
  <h2 class="section-title"><LayerBadge layer={layer} /> {title ?? labels[layer].title}{count != null && <span class="count">{count}</span>}</h2>
  <span class="meta">{labels[layer].note}</span>
</div>
