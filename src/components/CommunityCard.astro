---
/**
 * One community digest, conclusion first: the prevailing view on top with where it comes from;
 * pros/cons, split opinions, tips and source threads open behind "자세한 의견 보기".
 */
import type { Game } from '../core/load';
import type { CommunityRecord, ModuleConfig } from '../core/schema';
import { gameHref, platformsOf, staleness } from '../core/hub';
import { communityKind, consensus } from '../i18n/ko';
import LayerBadge from './LayerBadge.astro';
import Freshness from './Freshness.astro';
import SourceList from './SourceList.astro';
interface Props { game: Game; mod: ModuleConfig; record: CommunityRecord; compact?: boolean; heading?: boolean }
const { game, mod, record: c, compact, heading } = Astro.props;
const url = gameHref(game, mod.id, c.id);
const platforms = platformsOf(game, c).filter((p) => p.type === 'COMMUNITY' || p.type === 'GUIDE');
const stale = staleness(game, c);
---
<article class="layer-card" data-layer="community">
  <p class="layer-card-top">
    <LayerBadge layer="community" /><span class="meta">{communityKind[c.kind]}</span>
    <span class="consensus" data-v={c.consensus} title={consensus[c.consensus].title}>{consensus[c.consensus].label}</span>
  </p>
  {heading ? <h1 class="article-title">{c.title}</h1> : <a class="headline" href={url}>{c.title}</a>}
  {c.verdicts.length > 0 && <dl class="verdicts">{c.verdicts.map((v) => <div><dt>{v.label}</dt><dd>{v.value}</dd></div>)}</dl>}
  <p class="conclusion">{c.summary}</p>
  {c.shift && <p class="shift"><span class="meta">평가 변화</span> 출시 당시 <b>{c.shift.release}</b> → 현재 <b>{c.shift.now}</b><span class="meta"> — {c.shift.reason}</span></p>}
  <p class="meta">{platforms.map((p) => p.name).join(' · ')}<span class="sep num">{c.version} 버전</span></p>
  {stale && <p class="stale" data-level={stale.level} role="note">⚠ {stale.text}</p>}
  {!compact && (
    <details class="more-toggle" open={heading}>
      <summary>자세한 의견 보기</summary>
      <div class="more-body">
        {(c.positive.length > 0 || c.negative.length > 0) && (
          <div class="opinions">
            {c.positive.length > 0 && <div data-tone="pos"><h3>긍정 의견</h3><ul>{c.positive.map((x) => <li>{x}</li>)}</ul></div>}
            {c.negative.length > 0 && <div data-tone="neg"><h3>부정·우려 의견</h3><ul>{c.negative.map((x) => <li>{x}</li>)}</ul></div>}
          </div>
        )}
        {c.divided.length > 0 && (
          <div class="divided">
            <h3>의견이 갈리는 지점</h3>
            {c.divided.map((d) => <div><p><b>{d.position}</b></p><ul>{d.reasons.map((x) => <li>{x}</li>)}</ul></div>)}
          </div>
        )}
        {c.tips.length > 0 && (
          <div class="tips">
            <h3>팁</h3>
            <ul>{c.tips.map((t) => <li>{t.text}{(t.when || t.who) && <span class="meta"> — {[t.when, t.who].filter(Boolean).join(' · ')}</span>}</li>)}</ul>
          </div>
        )}
        <Freshness game={game} record={c} quiet />
        <details><summary class="meta">근거 글 {c.sources.length}건</summary><SourceList game={game} refs={c.sources} compact /></details>
      </div>
    </details>
  )}
</article>
