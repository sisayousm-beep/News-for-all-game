---
import type { Game } from '../core/load';
import { href } from '../core/hub';
interface Props { game: Game; large?: boolean }
const { game, large } = Astro.props;
const { icon, accent } = game.config.theme;
---
<span class:list={['game-icon', { lg: large }]} style={`--accent:${accent}`} aria-hidden="true">
  {icon ? <img src={href(icon)} alt="" loading="lazy" /> : game.config.name.slice(0, 1)}
</span>
