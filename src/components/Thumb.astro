---
/**
 * Record image, else the game's key visual (theme.cover) with a small category label, else a game-colored tile.
 * `size`: row (list thumbnail) · wide (16:9 media block for featured / lead stories).
 */
import type { Game } from '../core/load';
import { href } from '../core/hub';
interface Props { game: Game; image?: string; label: string; size?: 'row' | 'wide' | 'banner' }
const { game, image, label, size = 'row' } = Astro.props;
const src = image ?? game.config.theme.cover;
---
<span class:list={['thumb', `thumb-${size}`, { 'is-cover': !image && src, 'is-fallback': !src }]} style={`--accent:${game.config.theme.accent}`} aria-hidden="true">
  {src && <img src={href(src)} alt="" loading="lazy" decoding="async" />}
  {!image && (src ? <span class="thumb-label">{label}</span> : <span class="thumb-fallback"><b>{label}</b><small>{game.config.names.en ?? game.config.name}</small></span>)}
</span>
