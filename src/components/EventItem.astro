---
/**
 * Schedule row. `compact`: game icon · title · remaining (home / sidebars). Default: date column timeline row.
 * Status and D-day are rendered at build time and re-evaluated in the browser (see Base.astro).
 */
import type { Game } from '../core/load';
import type { EventRecord, ModuleConfig } from '../core/schema';
import { clock, dday, eventStatus, gameHref, shortDate, weekday } from '../core/hub';
import { eventKind, eventStatus as statusLabel } from '../i18n/ko';
import Provenance from './Provenance.astro';
import GameTag from './GameTag.astro';
import GameIcon from './GameIcon.astro';
interface Props { game: Game; mod: ModuleConfig; event: EventRecord; showGame?: boolean; hideEnded?: boolean; compact?: boolean }
const { game, mod, event: e, showGame, hideEnded, compact } = Astro.props;
const status = eventStatus(e);
const range = `${shortDate(e.start)}${e.startNote ? ` ${e.startNote}` : ''} ~ ${e.end ? shortDate(e.end) : '미정'}`;
---
<li data-start={e.start} data-end={e.end ?? undefined} data-status={status} data-game={game.config.id} data-kind={e.kind}
  data-hide-ended={hideEnded ? '' : undefined} hidden={hideEnded && status === 'ended'}>
  <a class="ev-row" href={gameHref(game, mod.id, e.id)}>
    {compact
      ? <GameIcon game={game} />
      : <span class="ev-date"><b>{shortDate(e.start)}</b><small>{weekday(e.start)}{clock(e.start) && ` ${clock(e.start)}`}</small></span>}
    <span class="ev-main">
      <span class="headline clamp-2">{e.title}</span>
      <span class="meta">
        {showGame && <><GameTag game={game} plain /><span class="sep" /></>}
        <span>{eventKind[e.kind]}</span><span class="sep num">{range}</span>
        {e.certainty !== 'confirmed' && <> <Provenance game={game} record={e} /></>}
      </span>
    </span>
    <span class="ev-side">
      <span class:list={['status', { 'sr-only': compact }]} data-status={status}>{statusLabel[status]}</span>
      <span class="dday" data-dday>{dday(e)}</span>
    </span>
  </a>
</li>
