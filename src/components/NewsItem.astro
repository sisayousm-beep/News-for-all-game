---
/** Compact news row: thumbnail · trust badge · game · category · headline · summary · source · date. */
import type { Game } from '../core/load';
import type { ModuleConfig, NewsRecord } from '../core/schema';
import { gameHref, listDate, primarySource } from '../core/hub';
import { newsCategory } from '../i18n/ko';
import Provenance from './Provenance.astro';
import GameTag from './GameTag.astro';
import Thumb from './Thumb.astro';
interface Props { game: Game; mod: ModuleConfig; news: NewsRecord; showGame?: boolean; dense?: boolean }
const { game, mod, news: n, showGame, dense } = Astro.props;
const url = gameHref(game, mod.id, n.id);
---
<li data-game={game.config.id} data-category={n.category}>
  <div class="news-row">
    {!dense && <a href={url} tabindex="-1"><Thumb game={game} image={n.image} label={newsCategory[n.category]} /></a>}
    <div class="news-body">
      <div class="news-top">
        {showGame && <GameTag game={game} plain />}
        <span>{newsCategory[n.category]}</span>
        <Provenance game={game} record={n} />
      </div>
      <a class="headline clamp-2" href={url}>{n.title}</a>
      {!dense && n.summary && <p class="dek clamp-2">{n.summary}</p>}
      <p class="meta">
        <span>{primarySource(game, n).name}</span><span class="sep num">{n.publishedAt ? listDate(n.publishedAt) : '게시일 미확인'}</span>
      </p>
    </div>
  </div>
</li>
