---
import type { Game } from '../../core/load';
import type { CommunityRecord, ModuleConfig } from '../../core/schema';
import { gameHref, listed } from '../../core/hub';
import LayerHead from '../../components/LayerHead.astro';
import CommunityCard from '../../components/CommunityCard.astro';
interface Props { game: Game; mod: ModuleConfig }
const { game, mod } = Astro.props;
const items = listed<CommunityRecord>(game, mod).filter((a) => a.status === 'current').sort((a, b) => (b.happenedAt ?? b.updatedAt).localeCompare(a.happenedAt ?? a.updatedAt));
---
<section class="section">
  <LayerHead layer="community" title={mod.label} count={items.length} />
  {items.length ? <div class="layer-list">{items.slice(0, 3).map((a) => <CommunityCard game={game} mod={mod} record={a} compact />)}</div> : <p class="empty">아직 정리된 여론이 없습니다.</p>}
  <p style="padding-top:8px"><a class="more" href={gameHref(game, mod.id)}>전체 보기</a></p>
</section>
