---
import type { Game } from '../../core/load';
import type { AnalysisRecord, ModuleConfig } from '../../core/schema';
import { gameHref, listed } from '../../core/hub';
import LayerHead from '../../components/LayerHead.astro';
import AnalysisCard from '../../components/AnalysisCard.astro';
interface Props { game: Game; mod: ModuleConfig }
const { game, mod } = Astro.props;
const items = listed<AnalysisRecord>(game, mod).filter((a) => a.status === 'current').sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
---
<section class="section">
  <LayerHead layer="analysis" title={mod.label} count={items.length} />
  {items.length ? <div class="layer-list">{items.slice(0, 3).map((a) => <AnalysisCard game={game} mod={mod} record={a} compact />)}</div> : <p class="empty">아직 등록된 계산이 없습니다.</p>}
  <p style="padding-top:8px"><a class="more" href={gameHref(game, mod.id)}>전체 보기</a></p>
</section>
