---
import type { Game } from '../../core/load';
import type { EventRecord, ModuleConfig } from '../../core/schema';
import { clock, dday, eventStatus, formatDate, gameHref, recordsOf } from '../../core/hub';
import { eventKind, eventStatus as statusLabel } from '../../i18n/ko';
import Provenance from '../../components/Provenance.astro';
import GameTag from '../../components/GameTag.astro';
import SourceList from '../../components/SourceList.astro';
import LayerLinks from '../../components/LayerLinks.astro';
import EventItem from '../../components/EventItem.astro';
import Media from '../../components/Media.astro';
interface Props { game: Game; mod: ModuleConfig; record: EventRecord }
const { game, mod, record: e } = Astro.props;
const status = eventStatus(e);
const others = recordsOf<EventRecord>(game, mod).filter((x) => x.id !== e.id && eventStatus(x) !== 'ended').sort((a, b) => Date.parse(a.start) - Date.parse(b.start)).slice(0, 6);
---
<div class="layout">
  <article class="article" data-start={e.start} data-end={e.end ?? undefined}>
    <div class="article-kicker"><GameTag game={game} /><span>{eventKind[e.kind]}</span><Provenance game={game} record={e} /></div>
    <h1 class="article-title">{e.title}</h1>
    <Media image={e.image} from={e.imageFrom} />
    <dl class="facts-grid num">
      <div><dt>상태</dt><dd><span class="status" data-status={status}>{statusLabel[status]}</span></dd></div>
      <div><dt>남은 기간</dt><dd class="dday" data-dday>{dday(e)}</dd></div>
      <div><dt>시작</dt><dd>{formatDate(e.start, false)}{clock(e.start) && ` ${clock(e.start)}`}{e.startNote && <span class="meta"> {e.startNote}</span>}</dd></div>
      <div><dt>종료</dt><dd>{e.end ? <>{formatDate(e.end, false)}{clock(e.end) && ` ${clock(e.end)}`}</> : '미정'}{e.endNote && <span class="meta"> {e.endNote}</span>}</dd></div>
    </dl>
    {e.summary && <p class="article-lead">{e.summary}</p>}
    {e.rewards.length > 0 && <section class="section"><div class="section-head"><h2 class="section-title">주요 보상</h2><span class="meta">공식 공지 기준</span></div><ul class="plain-list">{e.rewards.map((x) => <li>{x}</li>)}</ul></section>}
    <section class="section">
      <div class="section-head"><h2 class="section-title">출처 · 검증</h2></div>
      <SourceList game={game} refs={e.sources} />
    </section>
    <LayerLinks game={game} target={`${mod.collection}/${e.id}`} />
  </article>
  <div class="aside aside-sticky">
    <section class="section">
      <div class="section-head"><h2 class="section-title">다른 일정</h2><a class="more" href={gameHref(game, mod.id)}>전체</a></div>
      {others.length ? <ul class="ev-list compact">{others.map((x) => <EventItem game={game} mod={mod} event={x} compact hideEnded />)}</ul> : <p class="empty">다른 일정이 없습니다.</p>}
    </section>
  </div>
</div>
