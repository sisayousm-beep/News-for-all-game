---
/**
 * Entity page in three layers: 공식 (attributes, official topics, history) → 계산 → 커뮤니티.
 * Each official topic (a skill, a chain node…) shows which calculations / opinions are about it, so a reader
 * can follow one subject from the official text to the numbers to what players think.
 */
import type { Game } from '../../core/load';
import { ANALYSIS_KINDS, COMMUNITY_KINDS, type AnalysisRecord, type CommunityRecord, type EntityRecord, type ModuleConfig } from '../../core/schema';
import { formatDate, layerOf, linked, modulesOf, relatedNews } from '../../core/hub';
import { analysisKind, historyKind } from '../../i18n/ko';
import { fieldLabel } from './fields';
import Provenance from '../../components/Provenance.astro';
import Portrait from '../../components/Portrait.astro';
import SourceList from '../../components/SourceList.astro';
import NewsItem from '../../components/NewsItem.astro';
import LayerHead from '../../components/LayerHead.astro';
import LayerBadge from '../../components/LayerBadge.astro';
import AnalysisCard from '../../components/AnalysisCard.astro';
import CommunityCard from '../../components/CommunityCard.astro';
interface Props { game: Game; mod: ModuleConfig; record: EntityRecord }
const { game, mod, record: r } = Astro.props;
const news = relatedNews(game, r).slice(0, 5);
const history = [...r.history].sort((a, b) => (b.version ?? '').localeCompare(a.version ?? '', undefined, { numeric: true }) || Date.parse(b.date ?? '0') - Date.parse(a.date ?? '0'));

const target = `${mod.collection}/${r.id}`;
const anchor = (layer: string, id: string) => `#${layer}-${id}`;
const calc = linked<AnalysisRecord>(game, 'analysis', target);
const talk = linked<CommunityRecord>(game, 'community', target);
const unique = <T extends { record: unknown }>(xs: T[]) => xs.filter((x, i) => xs.findIndex((y) => y.record === x.record) === i);
// Most decision-relevant first: 돌파 효율 before build math, overall evaluation before details (enum order).
const calcCards = unique(calc).sort((a, b) => ANALYSIS_KINDS.indexOf(a.record.kind) - ANALYSIS_KINDS.indexOf(b.record.kind));
const talkCards = unique(talk).sort((a, b) => COMMUNITY_KINDS.indexOf(a.record.kind) - COMMUNITY_KINDS.indexOf(b.record.kind));
// "한눈에 보기": the top calculation's answer, then the headline verdicts of the top community record (kind order: evaluation first).
const glance = [
  ...calcCards.slice(0, 1).map((l) => ({ layer: 'analysis' as const, label: analysisKind[l.record.kind], value: l.record.results[0], href: anchor('analysis', l.record.id) })),
  ...talkCards.slice(0, 1).flatMap((l) => l.record.verdicts.map((v) => ({ layer: 'community' as const, label: v.label, value: v.value, href: anchor('community', l.record.id) }))),
];
const sections = mod.sections.map((s) => ({ ...s, topics: r.topics.filter((t) => t.section === s.key) })).filter((s) => s.topics.length);
const has = (layer: string) => modulesOf(game).some((m) => layerOf(m) === layer);
const showCalc = has('analysis'), showTalk = has('community');
---
<div class="entity">
  <aside class="entity-side">
    <Portrait game={game} record={r} tall />
    <div class="entity-name">
      <h1>{r.title}</h1>
      {r.aliases.length > 0 && <p class="meta">{r.aliases.join(' · ')}</p>}
      <p style="margin-top:6px"><Provenance game={game} record={r} /></p>
      {r.imageFrom && <p class="meta" style="margin-top:4px;font-size:.75rem">이미지: <a href={r.imageFrom} target="_blank" rel="noopener noreferrer" style="text-decoration:underline">{new URL(r.imageFrom).hostname}</a></p>}
    </div>
    <dl class="facts entity-extra">
      {mod.fields.map((f) => (
        <>
          <dt>{f.label}</dt>
          <dd class:list={{ rarity: f.key === 'rarity' }} data-v={f.key === 'rarity' ? r.attributes.rarity : undefined}>{fieldLabel(f, r.attributes[f.key]) ?? <span class="badge unknown" title="출처에서 확인되지 않은 값">미확인</span>}</dd>
        </>
      ))}
      <dt>갱신</dt><dd class="num">{formatDate(r.updatedAt, false)}</dd>
    </dl>
    <nav class="layer-jump" aria-label="정보 단계">
      <a href="#layer-official"><LayerBadge layer="official" /> 공식 데이터</a>
      {showCalc && <a href="#layer-analysis"><LayerBadge layer="analysis" /> 성능 분석 <span class="count">{calcCards.length}</span></a>}
      {showTalk && <a href="#layer-community"><LayerBadge layer="community" /> 커뮤니티 <span class="count">{talkCards.length}</span></a>}
    </nav>
  </aside>

  <div class="entity-main">
    {glance.length > 0 && (
      <section class="glance" aria-label="한눈에 보기">
        <h2 class="section-title">한눈에 보기</h2>
        <dl>
          {glance.map((g) => (
            <a href={g.href} data-layer={g.layer}>
              <dt><LayerBadge layer={g.layer} /> {g.label}</dt>
              <dd>{g.value}</dd>
            </a>
          ))}
        </dl>
      </section>
    )}
    <section class="section">
      <LayerHead layer="official" title="기본 정보" id="layer-official" />
      {r.summary ? <p class="prose" style="padding-top:12px">{r.summary}</p> : <p class="empty">등록된 소개가 없습니다.</p>}
    </section>

    {sections.map((s) => (
      <section class="section">
        <div class="section-head"><h2 class="section-title"><LayerBadge layer="official" /> {s.label}<span class="count">{s.topics.length}</span></h2></div>
        <ol class="topics">
          {s.topics.map((t) => {
            const tc = calc.filter((l) => l.topic === t.id), tt = talk.filter((l) => l.topic === t.id);
            return (
              <li class="topic" id={`t-${t.id}`}>
                {t.text || t.sources.length || tc.length || tt.length ? (
                  <details class="topic-toggle">
                    <summary>
                      <span class="topic-name">{t.name}</span>
                      <span class="topic-marks">{tc.length > 0 && <LayerBadge layer="analysis" />}{tt.length > 0 && <LayerBadge layer="community" />}</span>
                    </summary>
                    <div class="topic-body">
                      {t.text && <p class="prose">{t.text}</p>}
                      {Object.keys(t.values).length > 0 && <dl class="topic-values num">{Object.entries(t.values).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
                      {t.sources.length > 0 && <details><summary class="meta">출처 {t.sources.length}건</summary><SourceList game={game} refs={t.sources} compact /></details>}
                      {(tc.length > 0 || tt.length > 0) && (
                        <ul class="chain-links" aria-label={`${t.name} — 계산·커뮤니티`}>
                          {tc.map((l) => <li><LayerBadge layer="analysis" /><a href={anchor('analysis', l.record.id)}>{l.record.results[0]}</a></li>)}
                          {tt.map((l) => <li><LayerBadge layer="community" /><a href={anchor('community', l.record.id)}>{l.record.summary}</a></li>)}
                        </ul>
                      )}
                    </div>
                  </details>
                ) : (
                  <>
                    <p class="topic-name">{t.name}</p>
                    {Object.keys(t.values).length > 0 && <dl class="topic-values num">{Object.entries(t.values).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
                  </>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <section class="section">
      <div class="section-head"><h2 class="section-title"><LayerBadge layer="official" /> 변경 이력<span class="count">{history.length}</span></h2><span class="meta">출시·복각·조정</span></div>
      {history.length ? (
        <ol class="history">
          {history.map((h) => (
            <li>
              <span class="when num"><b>{h.version ? `v${h.version}` : '—'}</b><span>{h.date ? formatDate(h.date, false) : '날짜 미확인'}</span></span>
              <div class="what">
                <p><span class="badge outline">{historyKind[h.kind]}</span> {h.date && Date.parse(h.date) > Date.now() && <span class="status" data-status="upcoming">예정</span>}</p>
                <p>{h.summary}</p>
                <details><summary class="meta">출처 {h.sources.length}건</summary><SourceList game={game} refs={h.sources} compact /></details>
              </div>
            </li>
          ))}
        </ol>
      ) : <p class="empty">기록된 변경 이력이 없습니다.</p>}
    </section>

    {showCalc && <section class="section">
      <LayerHead layer="analysis" title="성능 분석" count={calcCards.length} id="layer-analysis" />
      <div class="layer-list">
        {calcCards.map((l) => <div id={`analysis-${l.record.id}`}><AnalysisCard game={game} mod={l.mod} record={l.record} /></div>)}
      </div>
      {!calcCards.length && <p class="empty">아직 등록된 계산·통계가 없습니다.</p>}
    </section>}

    {showTalk && <section class="section">
      <LayerHead layer="community" count={talkCards.length} id="layer-community" />
      {talkCards.length ? (
        <div class="layer-list">{talkCards.map((l) => <div id={`community-${l.record.id}`}><CommunityCard game={game} mod={l.mod} record={l.record} /></div>)}</div>
      ) : <p class="empty">아직 정리된 커뮤니티 여론이 없습니다.</p>}
    </section>}

    <section class="section">
      <div class="section-head"><h2 class="section-title">관련 뉴스<span class="count">{news.length}</span></h2></div>
      {news.length ? <ul class="news-list">{news.map((t) => <NewsItem game={t.game} mod={t.mod} news={t.record} />)}</ul> : <p class="empty">이 {mod.itemLabel ?? '항목'}을(를) 언급한 소식이 아직 없습니다.</p>}
    </section>

    <section class="section">
      <div class="section-head"><h2 class="section-title">출처 · 검증</h2><span class="meta">공식 데이터의 출처</span></div>
      <SourceList game={game} refs={r.sources} />
    </section>
  </div>
</div>
