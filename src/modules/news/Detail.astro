---
import type { Game } from '../../core/load';
import type { ModuleConfig, NewsRecord } from '../../core/schema';
import { formatDate, gameHref, newsDate, recordsOf } from '../../core/hub';
import { newsCategory } from '../../i18n/ko';
import Provenance from '../../components/Provenance.astro';
import GameTag from '../../components/GameTag.astro';
import SourceList from '../../components/SourceList.astro';
import Analysis from '../../components/Analysis.astro';
import NewsItem from '../../components/NewsItem.astro';
interface Props { game: Game; mod: ModuleConfig; record: NewsRecord }
const { game, mod, record: n } = Astro.props;
const more = recordsOf<NewsRecord>(game, mod).filter((x) => x.id !== n.id).sort((a, b) => Date.parse(newsDate(b)) - Date.parse(newsDate(a))).slice(0, 5);
const search = (t: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/search/?q=${encodeURIComponent(t)}`;
---
<div class="layout">
  <article class="article">
    <div class="article-kicker"><GameTag game={game} /><span>{newsCategory[n.category]}</span><Provenance game={game} record={n} /></div>
    <h1 class="article-title">{n.title}</h1>
    <p class="article-byline num">
      <span>{n.publishedAt ? `${formatDate(n.publishedAt)} 게시` : '게시일 미확인'}</span>
      <span class="sep">출처 {n.sources.length}건</span>
      <span class="sep">{formatDate(n.updatedAt, false)} 갱신</span>
    </p>
    {n.summary ? <p class="article-lead">{n.summary}</p> : <p class="empty">요약이 없습니다. 원문 출처를 확인하세요.</p>}
    {n.tags.length > 0 && <p class="tags">{n.tags.map((t) => <a href={search(t)}>#{t}</a>)}</p>}
    {n.analysis && <Analysis game={game} analysis={n.analysis} />}
    <section class="section">
      <div class="section-head"><h2 class="section-title">출처 · 검증</h2><span class="meta">원문 링크를 확인하세요</span></div>
      <SourceList game={game} refs={n.sources} />
    </section>
  </article>
  <div class="aside aside-sticky">
    <section class="section">
      <div class="section-head"><h2 class="section-title">{game.config.name} 다른 소식</h2><a class="more" href={gameHref(game, mod.id)}>전체</a></div>
      {more.length ? <ul class="news-list dense">{more.map((x) => <NewsItem game={game} mod={mod} news={x} dense />)}</ul> : <p class="empty">다른 소식이 없습니다.</p>}
    </section>
  </div>
</div>
