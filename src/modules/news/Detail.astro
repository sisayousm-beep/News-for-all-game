---
import type { Game } from '../../core/load';
import type { ModuleConfig, NewsRecord } from '../../core/schema';
import { formatDate } from '../../core/hub';
import { newsCategory } from '../../i18n/ko';
import Certainty from '../../components/Certainty.astro';
import SourceList from '../../components/SourceList.astro';
import Analysis from '../../components/Analysis.astro';
interface Props { game: Game; mod: ModuleConfig; record: NewsRecord }
const { game, record: n } = Astro.props;
---
<article class="card">
  <div class="row small">
    <span class="badge">{newsCategory[n.category]}</span>
    <Certainty value={n.certainty} />
    <span class="muted">{n.publishedAt ? formatDate(n.publishedAt) : '게시일 미확인'}</span>
  </div>
  <h2>{n.title}</h2>
  {n.summary && <p class="prose">{n.summary}</p>}
  {n.tags.length > 0 && <div class="row">{n.tags.map((t) => <span class="badge">#{t}</span>)}</div>}
  <SourceList game={game} refs={n.sources} />
</article>
{n.analysis && <Analysis game={game} analysis={n.analysis} />}
