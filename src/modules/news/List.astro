---
import type { Game } from '../../core/load';
import type { ModuleConfig, NewsRecord } from '../../core/schema';
import { newsDate, recordsOf } from '../../core/hub';
import { newsCategory } from '../../i18n/ko';
import NewsItem from '../../components/NewsItem.astro';
import TrustLegend from '../../components/TrustLegend.astro';
interface Props { game: Game; mod: ModuleConfig }
const { game, mod } = Astro.props;
const items = recordsOf<NewsRecord>(game, mod).sort((a, b) => Date.parse(newsDate(b)) - Date.parse(newsDate(a)));
const categories = [...new Set(items.map((n) => n.category))];
---
<div class="layout">
  <section class="section" data-cat-filter>
    {categories.length > 1 && (
      <div class="toolbar chips" role="group" aria-label="분류">
        <button class="chip" type="button" data-value="" aria-pressed="true">전체 {items.length}</button>
        {categories.map((c) => <button class="chip" type="button" data-value={c} aria-pressed="false">{newsCategory[c]} {items.filter((n) => n.category === c).length}</button>)}
      </div>
    )}
    {items.length ? <ul class="news-list">{items.map((n) => <NewsItem game={game} mod={mod} news={n} />)}</ul> : <p class="empty">아직 수집된 소식이 없습니다.</p>}
  </section>
  <div class="aside aside-sticky">
    <section class="section"><div class="section-head"><h2 class="section-title">정보 표시 기준</h2></div><TrustLegend /></section>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-cat-filter]').forEach((root) => {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      root.querySelectorAll<HTMLElement>('.news-list > li').forEach((li) => { li.hidden = !!c.dataset.value && li.dataset.category !== c.dataset.value; });
    }));
  });
</script>
