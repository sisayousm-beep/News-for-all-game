---
/**
 * Game hub home: one widget per enabled module, in game.yaml order.
 * Reading widgets (news, community, analysis) take the wide column; version/codes/schedule/database sit in the side column.
 */
import GameShell from '../../../layouts/GameShell.astro';
import { games } from '../../../core/hub';
import { views, WIDE_TYPES } from '../../../modules';

export const getStaticPaths = () => games().map((game) => ({ params: { game: game.config.id }, props: { game } }));
const { game } = Astro.props;
const main = game.config.modules.filter((m) => WIDE_TYPES.includes(m.type));
const side = game.config.modules.filter((m) => !WIDE_TYPES.includes(m.type));
---
<GameShell game={game} current="overview">
  <div class="layout">
    <div class="aside" style="gap:32px">
      <p class="dek">{game.config.description}</p>
      {(main.length ? main : side).map((mod) => { const { Widget } = views[mod.type]; return <Widget game={game} mod={mod} />; })}
    </div>
    {main.length > 0 && side.length > 0 && (
      <div class="aside home-side">{side.map((mod) => { const { Widget } = views[mod.type]; return <Widget game={game} mod={mod} />; })}</div>
    )}
  </div>
</GameShell>
