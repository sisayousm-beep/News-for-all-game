---
import GameShell from '../../../../layouts/GameShell.astro';
import { games, gameHref, recordsOf } from '../../../../core/hub';
import type { AnyRecord } from '../../../../core/schema';
import { views } from '../../../../modules';

export const getStaticPaths = () =>
  games().flatMap((game) =>
    game.config.modules.flatMap((mod) =>
      recordsOf<AnyRecord>(game, mod).map((record) => ({ params: { game: game.config.id, module: mod.id, id: record.id }, props: { game, mod, record } })),
    ),
  );
const { game, mod, record } = Astro.props;
const { Detail } = views[mod.type];
---
<GameShell game={game} current={mod.id} title={record.title}>
  <nav class="crumbs" aria-label="위치">
    <a href={gameHref(game)}>{game.config.name}</a><span aria-hidden="true">/</span>
    <a href={gameHref(game, mod.id)}>{mod.label}</a><span aria-hidden="true">/</span>
    <span class="clamp-1" aria-current="page">{record.title}</span>
  </nav>
  <Detail game={game} mod={mod} record={record} />
</GameShell>
