---
import Base from '../../layouts/Base.astro';
import GameIcon from '../../components/GameIcon.astro';
import { games, gameHref } from '../../core/hub';
---
<Base title="게임" nav="games">
  <h1>게임</h1>
  <div class="grid">
    {games().map((g) => (
      <a class="card card-link" href={gameHref(g)} style={`--accent:${g.config.theme.accent}`}>
        <div class="row"><GameIcon game={g} /><div><h2>{g.config.name}</h2><span class="muted small">{g.config.genre} · {g.config.region}</span></div></div>
        <p class="muted small">{g.config.description}</p>
        <div class="row">{g.config.modules.map((m) => <span class="badge">{m.label}</span>)}</div>
      </a>
    ))}
  </div>
</Base>
