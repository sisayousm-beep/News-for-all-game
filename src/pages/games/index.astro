---
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import { games } from '../../core/hub';
---
<Base title="게임" nav="games">
  <div class="page-head">
    <h1 class="page-title">게임</h1>
    <p class="meta">{games().length}개 게임 · 게임마다 제공하는 정보(탭)가 다릅니다</p>
  </div>
  <div class="game-cards">{games().map((g) => <GameCard game={g} full />)}</div>
</Base>
